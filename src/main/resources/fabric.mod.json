{
  "schemaVersion": 1,
  "id": "mbtfly",
  "version": "${version}",
  "name": "MBTFly",
  "description": "自动飞行模组 - 帮助玩家自动飞行到指定坐标",
  "authors": [
    "Maple_Bamboo_Team"
  ],
  "contact": {
    "homepage": "https://github.com/AlsoLate/MBTFly",
    "issues": "https://github.com/AlsoLate/MBTFly/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/mbtfly/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "top.maple_bamboo_team.mbtfly.client.MBTFlyClient"
    ]
  },
  "mixins": [
    "mbtfly.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=0.135.0",
    "minecraft": "1.21.11"
  },
  "recommends": {
    "fabric-api": ">=0.141.0"
  },
  "custom": {
    "fabric-api:module-lifecycle": "client"
  }
}